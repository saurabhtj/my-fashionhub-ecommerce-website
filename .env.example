# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fashionhub?schema=public"

# SQLite source URL (only used for one-time historical data migration)
SQLITE_SOURCE_URL="file:../dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-development-secret-key"

# CORS & Proxy Configuration
CORS_ORIGIN="http://localhost:3000"
API_PROXY_ORIGIN="https://fashion-hub-api.onrender.com"

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_test_webhook_secret"
RAZORPAY_MODE="test"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
