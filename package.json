{
  "name": "fashion-hub-nextjs",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "admin:promote": "node scripts/promote-admin.mjs",
    "db:generate": "prisma generate && prisma generate --schema prisma/sqlite-source/schema.prisma",
    "db:migrate:sqlite-to-postgres": "npm run db:generate && node scripts/migrate-sqlite-to-postgres.mjs",
    "test:payments": "node --test tests/razorpay-signatures.test.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.1",
    "next": "16.3.6",
    "next-auth": "^4.24.15",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn-ui": "^0.9.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
