# Backend Environment Variables (Render Web Service Settings)
# Handled via render.yaml Blueprint or entered in Render Dashboard

# PostgreSQL internal connection string (provided automatically from fashion-hub-postgres)
DATABASE_URL="postgresql://user:password@fashion-hub-postgres:5432/database"

# NextAuth secret (generated automatically by Render Blueprint)
NEXTAUTH_SECRET="generate-value-or-random-string"

# Frontend production URL
NEXTAUTH_URL="https://your-site.netlify.app"

# Allowed browser CORS origin (exact Netlify production origin, no trailing slash)
CORS_ORIGIN="https://your-site.netlify.app"

# Razorpay Test Mode credentials (Render prompts for these on Blueprint apply)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_test_webhook_secret"
RAZORPAY_MODE="test"

# Node environment and port (Render provides PORT automatically)
NODE_ENV="production"
PORT="10000"
