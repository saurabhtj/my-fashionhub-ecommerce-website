generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_SOURCE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  phone         String?
  image         String?
  password      String?
  role          String     @default("USER") // USER or ADMIN
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  wishlists     Wishlist[]
  cartItems     CartItem[]
  addresses     Address[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id                       String                @id @default(cuid())
  userId                   String
  idempotencyKey           String?
  razorpayOrderId          String?               @unique
  amount                   Float
  subtotal                 Float                 @default(0)
  shippingFee              Float                 @default(0)
  currency                 String                @default("INR")
  status                   String                @default("CREATED") // CREATED, AWAITING_PAYMENT, CONFIRMED, PAID, FAILED
  paymentStatus            String                @default("PENDING") // PENDING, PAID, FAILED, UNPAID, REFUNDED, PARTIALLY_REFUNDED
  paymentMethod            String                @default("RAZORPAY")
  deliveryStatus           String                @default("PROCESSING")
  expectedDelivery         DateTime?
  trackingNumber           String?
  customerName             String?
  customerPhone            String?
  customerEmail            String?
  shippingAddress          String?
  paymentId                String?
  signature                String?
  paymentSignatureVerified Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  user                     User                  @relation(fields: [userId], references: [id])
  items                    OrderItem[]
  webhookEvents            PaymentWebhookEvent[]

  @@unique([userId, idempotencyKey])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  cartItemId  String?
  productName String
  image       String?
  unitPrice   Float
  quantity    Int
  size        String?
  color       String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentWebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  eventType  String
  orderId    String?
  receivedAt DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model Product {
  id           String     @id @default(cuid())
  name         String
  description  String?
  tag          String?
  price        Float
  category     String
  image        String
  stock        Int        @default(0)
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wishlistedBy Wishlist[]
  cartItems    CartItem[]

  @@index([isArchived, category])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  size      String?
  color     String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, color])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  address     String
  houseNumber String?
  street      String?
  area        String?
  landmark    String?
  city        String
  state       String?
  pincode     String
  country     String   @default("India")
  addressType String   @default("HOME")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
