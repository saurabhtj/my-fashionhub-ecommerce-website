# Frontend Environment Variables (Netlify Site Settings)
# Enter these in Netlify: Site Configuration -> Environment Variables
# Do NOT include database credentials or Razorpay secrets in Netlify.

# Render API backend origin (HTTPS, no trailing slash)
API_PROXY_ORIGIN="https://fashion-hub-api.onrender.com"

# Netlify site production URL
NEXTAUTH_URL="https://your-site.netlify.app"

# NextAuth secret (copy the exact value generated for the Render service)
NEXTAUTH_SECRET="your-nextauth-secret"

# Optional client-side Razorpay test key ID (NEVER place key secrets here)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
